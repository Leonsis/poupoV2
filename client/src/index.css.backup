@import 'tailwindcss/base';
@import 'tailwindcss/components';
@import 'tailwindcss/utilities';
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.3s ease, color 0.3s ease;
}


/* Scrollbar customizada */

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: #00ffae;
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: #008a5f;
}


/* Animações customizadas */

.fade-in {
    animation: fadeIn 0.5s ease-in-out;
}

.slide-up {
    animation: slideUp 0.3s ease-out;
}

.bounce-gentle {
    animation: bounceGentle 2s infinite;
}


/* Transições suaves */

.transition-all {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}


/* Efeitos de hover */

.hover-lift:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.hover-glow:hover {
    box-shadow: 0 0 20px rgba(0, 255, 174, 0.3);
}


/* Gradientes customizados */

.gradient-primary {
    background: linear-gradient(135deg, #00ffae 0%, #008a5f 100%);
}

.gradient-secondary {
    background: linear-gradient(135deg, #006e4b 0%, #008a5f 100%);
}

.gradient-dark {
    background: linear-gradient(135deg, #1A2226 0%, #2a3236 100%);
}


/* Botões customizados - CORRIGIDOS */

.btn-primary {
    @apply bg-primary text-black font-medium px-6 py-3 rounded-lg transition-all duration-300;
    @apply hover: bg-primary-dark hover: shadow-lg hover: shadow-primary/25;
    @apply focus: outline-none focus: ring-2 focus: ring-primary focus: ring-opacity-50;
    @apply active: scale-95 disabled: opacity-50 disabled: cursor-not-allowed disabled: transform-none;
    @apply border-0 shadow-sm;
}

.btn-primary:hover {
    @apply text-black;
}

.btn-secondary {
    @apply bg-secondary text-white font-medium px-6 py-3 rounded-lg transition-all duration-300;
    @apply hover: bg-secondary-light hover: shadow-lg hover: shadow-secondary/25;
    @apply focus: outline-none focus: ring-2 focus: ring-secondary focus: ring-opacity-50;
    @apply active: scale-95 disabled: opacity-50 disabled: cursor-not-allowed disabled: transform-none;
    @apply border-0 shadow-sm;
}

.btn-outline {
    @apply border-2 border-primary text-primary font-medium px-6 py-3 rounded-lg transition-all duration-300;
    @apply hover: bg-primary hover: text-black hover: shadow-lg hover: shadow-primary/25;
    @apply focus: outline-none focus: ring-2 focus: ring-primary focus: ring-opacity-50;
    @apply active: scale-95 disabled: opacity-50 disabled: cursor-not-allowed disabled: transform-none;
    @apply bg-transparent shadow-sm;
}

.btn-outline:hover {
    @apply text-black;
}

.btn-danger {
    @apply bg-red-600 text-white font-medium px-6 py-3 rounded-lg transition-all duration-300;
    @apply hover: bg-red-700 hover: shadow-lg hover: shadow-red-600/25;
    @apply focus: outline-none focus: ring-2 focus: ring-red-600 focus: ring-opacity-50;
    @apply active: scale-95 disabled: opacity-50 disabled: cursor-not-allowed disabled: transform-none;
    @apply border-0 shadow-sm;
}

.dark .btn-danger {
    @apply bg-red-600 text-white;
}

.dark .btn-danger:hover {
    @apply bg-red-700 text-white;
}


/* Inputs customizados - CORRIGIDOS */

.input-primary {
    @apply w-full px-4 py-3 border-2 border-gray-300 rounded-lg;
    @apply focus: border-primary focus: outline-none focus: ring-2 focus: ring-primary focus: ring-opacity-50;
    @apply transition-all duration-300 bg-white text-gray-900;
    @apply placeholder: text-gray-500;
    @apply disabled: opacity-50 disabled: cursor-not-allowed;
}

.input-primary:focus {
    @apply border-primary shadow-sm shadow-primary/25;
}


/* Cards customizados */

.card {
    @apply bg-white dark: bg-dark-light rounded-xl shadow-lg p-6 transition-all duration-300;
    @apply hover: shadow-xl border border-gray-100 dark: border-gray-700;
}

.card-dark {
    @apply bg-dark-light dark: bg-dark-lighter rounded-xl shadow-lg p-6 transition-all duration-300;
    @apply hover: shadow-xl border border-gray-700 dark: border-gray-600;
}


/* Modo escuro - CORRIGIDO */

.dark {
    color-scheme: dark;
}

.dark body {
    background-color: #1A2226;
    color: #E0E0E0;
}

.dark .card {
    @apply bg-dark-light border-gray-700;
}

.dark .input-primary {
    @apply bg-dark-light border-gray-600 text-light placeholder: text-gray-400;
}

.dark .input-primary:focus {
    @apply border-primary bg-dark-light;
}


/* Botões no modo escuro - CORRIGIDOS */

.dark .btn-primary {
    @apply bg-primary text-black;
}

.dark .btn-primary:hover {
    @apply bg-primary-dark text-black;
}

.dark .btn-secondary {
    @apply bg-secondary text-white;
}

.dark .btn-secondary:hover {
    @apply bg-secondary-light text-white;
}

.dark .btn-outline {
    @apply border-primary text-primary;
}

.dark .btn-outline:hover {
    @apply bg-primary text-black;
}


/* Responsividade - MELHORADA */

@media (max-width: 768px) {
    .btn-primary,
    .btn-secondary,
    .btn-outline {
        @apply px-4 py-2.5 text-sm;
    }
    .card {
        @apply p-4;
    }
    .input-primary {
        @apply px-3 py-2.5 text-sm;
    }
}

@media (max-width: 640px) {
    .btn-primary,
    .btn-secondary,
    .btn-outline {
        @apply px-3 py-2 text-sm w-full;
    }
}


/* Utilitários customizados */

.text-gradient {
    background: linear-gradient(135deg, #00ffae 0%, #008a5f 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.border-gradient {
    border: 2px solid;
    border-image: linear-gradient(135deg, #00ffae 0%, #008a5f 100%) 1;
}


/* Loading spinner */

.spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #00ffae;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}


/* Toast notifications */

.toast-success {
    @apply bg-green-500 text-white;
}

.toast-error {
    @apply bg-red-500 text-white;
}

.toast-info {
    @apply bg-blue-500 text-white;
}


/* Status indicators */

.status-paid {
    @apply bg-green-100 text-green-800 dark: bg-green-900 dark: text-green-200;
}

.status-pending {
    @apply bg-yellow-100 text-yellow-800 dark: bg-yellow-900 dark: text-yellow-200;
}

.status-overdue {
    @apply bg-red-100 text-red-800 dark: bg-red-900 dark: text-red-200;
}


/* Melhorias para formulários */

.form-group {
    @apply mb-4;
}

.form-label {
    @apply block text-sm font-medium text-gray-700 dark: text-light mb-2;
}

.form-error {
    @apply text-red-500 text-sm mt-1;
}

.form-help {
    @apply text-gray-500 text-sm mt-1;
}


/* Melhorias para tabelas */

.table-container {
    @apply overflow-x-auto rounded-lg border border-gray-200 dark: border-gray-700;
}

.table {
    @apply w-full;
}

.table th {
    @apply text-left py-3 px-4 font-medium text-gray-700 dark: text-light bg-gray-50 dark: bg-dark-lighter;
}

.table td {
    @apply py-3 px-4 text-gray-900 dark: text-light border-b border-gray-100 dark: border-gray-800;
}

.table tr:hover {
    @apply bg-gray-50 dark: bg-dark-lighter;
}


/* Melhorias para badges e tags */

.badge {
    @apply px-2 py-1 rounded-full text-xs font-medium;
}

.badge-primary {
    @apply bg-primary/20 text-primary dark: bg-primary/30 dark: text-primary;
}

.badge-secondary {
    @apply bg-secondary/20 text-secondary dark: bg-secondary/30 dark: text-secondary;
}

.badge-success {
    @apply bg-green-100 text-green-800 dark: bg-green-900 dark: text-green-200;
}

.badge-warning {
    @apply bg-yellow-100 text-yellow-800 dark: bg-yellow-900 dark: text-yellow-200;
}

.badge-error {
    @apply bg-red-100 text-red-800 dark: bg-red-900 dark: text-red-200;
}


/* Melhorias para navegação */

.nav-link {
    @apply text-gray-600 dark: text-light hover: text-primary dark: hover: text-primary transition-colors;
}

.nav-link.active {
    @apply text-primary font-medium;
}


/* Melhorias para modais e overlays */

.modal-overlay {
    @apply fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50;
}

.modal-content {
    @apply bg-white dark: bg-dark-light rounded-xl shadow-2xl p-6 max-w-md w-full mx-4;
}


/* Melhorias para tooltips */

.tooltip {
    @apply relative;
}

.tooltip-content {
    @apply absolute z-10 px-2 py-1 text-sm text-white bg-gray-900 rounded shadow-lg;
    @apply opacity-0 invisible transition-all duration-200;
}

.tooltip:hover .tooltip-content {
    @apply opacity-100 visible;
}


/* Melhorias para dropdowns */

.dropdown {
    @apply relative;
}

.dropdown-menu {
    @apply absolute right-0 mt-2 w-48 bg-white dark: bg-dark-light rounded-lg shadow-lg border border-gray-200 dark: border-gray-700;
    @apply opacity-0 invisible transform scale-95 transition-all duration-200;
}

.dropdown.active .dropdown-menu {
    @apply opacity-100 visible transform scale-100;
}


/* Melhorias para paginação */

.pagination {
    @apply flex items-center space-x-2;
}

.pagination-item {
    @apply px-3 py-2 text-sm font-medium text-gray-700 dark: text-light bg-white dark: bg-dark-light border border-gray-300 dark: border-gray-600 rounded-lg;
    @apply hover: bg-gray-50 dark: hover: bg-dark-lighter transition-colors;
}

.pagination-item.active {
    @apply bg-primary text-black border-primary;
}

.pagination-item.disabled {
    @apply opacity-50 cursor-not-allowed hover: bg-white dark: hover: bg-dark-light;
}